{
    "name": "experiments",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*",
        "#exp/*": "./src/routes/exp/*"
    },
    "scripts": {
        "build:cloze": "deno run -A --import-map=scripts/test-import-map.json scripts/build-cloze-questions.ts",
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "export:ccg-figures": "node --experimental-strip-types scripts/export-ccg-figures.ts"
    },
    "dependencies": {
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.1",
        "debug": "^4.4.3",
        "dompurify": "^3.4.13",
        "katex": "^0.18.1",
        "pino": "^10.3.1",
        "runed": "^0.38.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "pino-pretty": "^13.1.3",
        "playwright": "^1.56.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.5",
        "typescript": "^6.0.0",
        "vite": "^8.0.12"
    }
}
