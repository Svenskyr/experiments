{
    "name": "experiments",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "packageManager": "bun@1.4.4",
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*",
        "#exp/*": "./src/routes/exp/*"
    },
    "scripts": {
        "dev": "vite dev",
        "build:cloze": "bun scripts/build-cloze-questions.ts",
        "build:svgs": "bun src/lib/exp/navigation/NavigationBar/v2/NavigationChevrons.ts && bun src/lib/exp/navigation/NavigationBar/v3/NavigationChevrons.ts",
        "build:assets": "bun run build:cloze && bun run build:svgs",
        "build": "bun run build:assets && bun scripts/vite-build.ts",
        "preview": "bun run build && wrangler dev",
        "preview:env": "bun run build && wrangler dev --env preview",
        "deploy": "bun run build && wrangler deploy",
        "deploy:preview": "bun run build && wrangler deploy --env preview",
        "cf-typegen": "wrangler types",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "mock-participant": "bun --tsconfig-override=scripts/tsconfig.json scripts/mock-complete-participant.ts",
        "export:ccg-figures": "bun scripts/export-ccg-figures.ts"
    },
    "dependencies": {
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.1",
        "debug": "^4.4.3",
        "dompurify": "^3.4.13",
        "katex": "^0.18.1",
        "runed": "^0.38.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^8.0.2",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@types/bun": "^1.4.4",
        "playwright": "^1.56.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.5",
        "typescript": "^6.0.0",
        "vite": "^8.0.12",
        "wrangler": "^4.159.0"
    }
}
