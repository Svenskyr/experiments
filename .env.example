# Local development. `vite dev` and `wrangler dev` both read `.env`.
# Production/preview: PUBLIC_* are Workers Builds *build variables* (inlined at build time);
# PRIVATE_* are Worker *secrets* (`bunx wrangler secret put NAME [--env preview]`).

PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
PUBLIC_SUPABASE_PUBLIC_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

PRIVATE_SUPABASE_SECRET_KEY=
PRIVATE_CCG_01_SECRET_KEY=
PRIVATE_PROLIFIC_API_KEY=
