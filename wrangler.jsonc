{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Production Worker (deployed from `main` by Workers Builds).
    "name": "experiments",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-11-01",
    // nodejs_compat provides AsyncLocalStorage, which `getRequestEvent()` relies on.
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
    },
    "observability": { "enabled": true },
    "workers_dev": true,
    // TODO(cutover): attach the production domain, e.g.
    // "routes": [{ "pattern": "experiments.example.org", "custom_domain": true }],

    // Secrets (set per Worker via `wrangler secret put <NAME> [--env preview]` or the dashboard):
    //   PRIVATE_SUPABASE_SECRET_KEY, PRIVATE_CCG_01_SECRET_KEY, PRIVATE_PROLIFIC_API_KEY
    // PUBLIC_* values are inlined at build time: set them as Workers Builds build variables.

    "env": {
        // Preview Worker, backed by the supabase-preview project.
        "preview": {
            "name": "experiments-preview",
            "workers_dev": true
        }
    }
}
